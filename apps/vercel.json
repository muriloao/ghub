{
    "version": 2,
    "builds": [
        {
            "src": "api/src/main.ts",
            "use": "@vercel/node"
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/landing_page/index.html",
            "has": [
                {
                    "type": "host",
                    "value": "ghub.digital"
                }
            ]
        },
        {
            "source": "/privacy-policy",
            "destination": "/api/public/privacy-policy.html",
            "has": [
                {
                    "type": "host",
                    "value": "api.ghub.digital"
                }
            ]
        },
        {
            "source": "/(.*)",
            "destination": "/api/src/main.ts",
            "has": [
                {
                    "type": "host",
                    "value": "api.ghub.digital"
                }
            ]
        }
    ]
}