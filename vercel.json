{
  "version": 2,
  "name": "ghub-api",
  "builds": [
    {
      "src": "apps/api/api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["apps/api/dist/**", "apps/api/public/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/api/api/index.ts"
    }
  ],
  "buildCommand": "cd apps/api && npm run build",
  "installCommand": "cd apps/api && npm install"
}